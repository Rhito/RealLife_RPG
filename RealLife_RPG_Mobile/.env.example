# API Backend URL
# Android Emulator: http://10.0.2.2:8000/api/v1
# iOS Simulator: http://localhost:8000/api/v1
# Thiết bị thật: http://YOUR_LAN_IP:8000/api/v1
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1

# Reverb WebSocket - phải match với REVERB_APP_KEY trong backend .env
EXPO_PUBLIC_REVERB_APP_KEY=your_reverb_app_key
EXPO_PUBLIC_REVERB_HOST=10.0.2.2
EXPO_PUBLIC_REVERB_PORT=8080
EXPO_PUBLIC_REVERB_SCHEME=http
